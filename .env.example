# ─── Mock / Dev toggle ───────────────────────────────────────────────────────
# Set to "true" to use the built-in mock WebSocket (no backend needed)
VITE_USE_MOCK_WS=true

# ─── WebSocket endpoints ──────────────────────────────────────────────────────
# Main caregiver data stream (mmWave sensor, vitals, etc.)
VITE_WS_URL=ws://localhost:8000/ws

# Caregiver socket (alerts, incidents)
VITE_CAREGIVER_WS_URL=ws://localhost:8000/caregiver

# Fall detector stream
VITE_FALL_DETECTOR_WS_URL=ws://localhost:8001/ws

# ─── Supabase ─────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>
